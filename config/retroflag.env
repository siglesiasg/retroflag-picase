# retroflag-picase configuration
# Deployed to: /etc/default/retroflag-picase
# After editing: run `sudo ./install.sh` to regenerate config.txt and restart the service.

# --- Power button (BCM numbering) ---
# GPIO 3 is the standard on NESPi+, SuperPi, MegaPi and NESPi 4.
# GPIO 3 also has the hardware ability to wake the Pi from halt.
BUTTON_GPIO=3

# --- Status LED (BCM numbering) ---
# GPIO 14 is the standard on RetroFlag cases.
LED_GPIO=14

# --- Power key action ---
# 'reboot' mirrors the original RetroFlag script (`shutdown -r now`): the case
# microcontroller cuts power, armed by the button press; the Pi just needs to
# shut down cleanly and reset the SoC. With 'poweroff' the SoC stays halted
# and most cases never cut power.
POWER_KEY_ACTION=reboot

# --- Power enable (BCM numbering) ---
# The case keeps power on while this pin is high; pulling it low signals the
# case circuit to cut power. Without it the Pi does `poweroff` but the case
# stays on and must be unplugged manually.
# Leave empty if your case does not have this circuit.
POWEREN_GPIO=4

# --- LED behaviour during shutdown ---
# Blink frequency (Hz) while systemd is shutting down.
LED_SHUTDOWN_BLINK_HZ=2
# Blink duration (s) before turning the LED off and exiting.
# Must be less than TimeoutStopSec in the systemd unit (15 s).
LED_SHUTDOWN_BLINK_SECS=5
